<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#bae6fd" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" rx="16" fill="url(#skyGrad)" />
  <rect x="0" y="280" width="600" height="120" fill="#22c55e" />
  <rect x="0" y="320" width="600" height="80" fill="#64748b" />
  <!-- House Base -->
  <rect x="150" y="160" width="300" height="150" fill="#ffffff" stroke="#334155" stroke-width="3" rx="4" />
  <!-- Roof -->
  <polygon points="130,160 300,70 470,160" fill="#ea580c" stroke="#c2410c" stroke-width="3" />
  <!-- Door -->
  <rect x="270" y="210" width="60" height="100" fill="#854d0e" rx="4" />
  <circle cx="320" cy="260" r="4" fill="#fde047" />
  <!-- Windows -->
  <rect x="180" y="190" width="60" height="60" fill="#e0f2fe" stroke="#0284c7" stroke-width="2" rx="4" />
  <rect x="360" y="190" width="60" height="60" fill="#e0f2fe" stroke="#0284c7" stroke-width="2" rx="4" />
  <!-- Info Overlay Tag -->
  <rect x="20" y="20" width="260" height="60" rx="8" fill="#0f172a" fill-opacity="0.8" />
  <text x="35" y="44" fill="#38bdf8" font-family="sans-serif" font-size="14" font-weight="bold">FOTO RUMAH / BANGUNAN</text>
  <text x="35" y="65" fill="#f8fafc" font-family="sans-serif" font-size="12">Kordinat Geotagging Valid</text>
</svg>
